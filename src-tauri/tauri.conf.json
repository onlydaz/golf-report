{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phần Mềm Thu Thập Dữ Liệu Độ Cong Gậy Golf",
  "mainBinaryName": "golf-report",
  "version": "0.1.0",
  "identifier": "com.golf.report",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phần Mềm Thu Thập Dữ Liệu Độ Cong Gậy Golf",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "resources/database_config.toml": "resources/database_config.toml"
    },
    "windows": {
      "wix": {
        "upgradeCode": "9c4c0768-b21a-5fb4-9388-c4953f8a84ed",
        "fragmentPaths": ["installer-permissions.wxs"],
        "componentRefs": ["ApplicationRuntimePermissions"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
